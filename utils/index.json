{
  "Instruction": "Send an image to the API to detect signs and receive bounding box coordinates and labels.",
  "Endpoint": "/predict",
  "Method": "POST",
  "Request_Pattern": {
    "Content-Type": "multipart/form-data",
    "Body": {
      "file": "Upload an image file (jpg, png, jpeg)"
    }
  },
  "Alternative_JSON_Request": {
    "Content-Type": "application/json",
    "Body": {
      "image_base64": "Base64 encoded image string"
    }
  },
  "Response_Format": {
    "detections": [
      {
        "label": "sign_name",
        "confidence": 0.90,
        "bbox": {
          "x_min": 0,
          "y_min": 0,
          "x_max": 0,
          "y_max": 0
        }
      }
    ]
  }
}